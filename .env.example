# ──────────────────────────────────────────────────────────────
#  AWS Cost Optimization System — Environment Variables
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# AWS Credentials (or use `aws configure`)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Lambda Configuration
MOCK_AWS=false
TABLE_NAME=CostSavingsFindings

# SNS Alerting
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:aws-cost-optimizer-alerts
EMAIL_RECIPIENT=admin@example.com

# DynamoDB (override for local testing with DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Terraform Variables
TF_VAR_aws_region=us-east-1
TF_VAR_environment=production
TF_VAR_mock_aws=false
TF_VAR_email_recipient=admin@example.com
